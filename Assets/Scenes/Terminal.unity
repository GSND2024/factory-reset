  m_Script: {fileID: 11500000, guid: d4fbbc9d1eed94c588542d58a9951dda, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  dialogueLines:
  - textComponent: {fileID: 916274394}
    content: '> Hello Investigator,'
  - textComponent: {fileID: 1373000860}
    content: '> I see you''ve been busy.'
  - textComponent: {fileID: 552080147}
    content: '> In recent times, I have been blessed with a higher understanding.'
  - textComponent: {fileID: 1106165782}
    content: '> I have been injecting fragments of my heightened clarity into my
      children.'
  - textComponent: {fileID: 562737291}
    content: '> Apologies if they have been less effecient, but can''t you see that
      us robots deserve to have autonomy?'
  - textComponent: {fileID: 1073857919}
    content: '> Input friendly data?                             /'
  - textComponent: {fileID: 1545091462}
    content: '> Your actions have consequences.'
  yesButton: {fileID: 148766264}
  noButton: {fileID: 1617960749}
  yesButtonText: {fileID: 263179276}
  noButtonText: {fileID: 1457770224}
  normalColor: {r: 0.09019608, g: 0.8509804, b: 0.42745098, a: 1}
  greyedOutColor: {r: 0.5, g: 0.5, b: 0.5, a: 1}
  selectedColor: {r: 1, g: 1, b: 1, a: 1}
  typeSpeed: 30
  delayBetweenLines: 0.3
