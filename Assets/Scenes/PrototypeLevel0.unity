  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueHolder
  dialogue:
    name: White Bot
    sentences:
    - Hi! You can activate pressure plates by stepping on them, or pushing something
      heavy on them!
    - Make sure to double check for the green indicator for if the plate locked or
      not. (sometimes they can't lock!)
    - So sorry, I didn't mean to stand in your way.
    - Go on ahead!
    hackedSentences:
    - Ugh. Please don't hack me again!
    hacked: 0
